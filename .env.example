# AIポケットファミリーの設定の見本（値は空のまま。本物の値はここに書かず、Vercel の環境変数か、手元の .env に入れる）
# Claude（キャラの頭脳・日記・絵）
ANTHROPIC_API_KEY=
PF_MODEL=
# Fish Audio（キャラの声）。コロンの声のID。ちゃむは private/chamu_voice_ref.wav（作者の録音・公開しない）があればそれをお手本に、なければ公式の声で話す
FISH_API_KEY=
FISH_VOICE_COLON=
PF_VOICE_MODEL=
# YouTube（好きな曲さがし）
YOUTUBE_API_KEY=
# LINE 公式アカウント（「助けて」のお知らせ）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
PF_LINE_ADD_URL=
# Upstash（「助けて」と見回りの記録置き場）。どちらかの組
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 見回り（毎日の cron）の合言葉
CRON_SECRET=
# アプリのURL
PF_URL=
# 手元で試すとき（scripts/dev.mjs）
PF_MOCK=
PF_FAMILY_REAL=
LINE_API_BASE=
PORT=
